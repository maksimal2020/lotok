# Пример переменных окружения. Скопируйте в .env для docker compose. НЕ коммитьте .env.
# Полный список с описанием — apps/api/src/config/config.ts и docs/DEPLOYMENT.md.

NODE_ENV=development
PUBLIC_URL=http://localhost:8080
ADMIN_PUBLIC_URL=http://localhost:8081

POSTGRES_PASSWORD=lotok
MINIO_ROOT_USER=lotok
MINIO_ROOT_PASSWORD=lotok-minio-secret

# В production обязательны собственные случайные значения (>= 32 символов): openssl rand -base64 48
JWT_ACCESS_SECRET=
APP_SIGNING_SECRET=
MOCK_PAYMENT_WEBHOOK_SECRET=
COOKIE_SECURE=false

# Поиск: opensearch | postgres
SEARCH_DRIVER=opensearch

# Платежи: mock (тестовый режим) | yookassa (нужны реквизиты магазина)
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# SMS: log | smsru (нужен SMSRU_API_ID)
SMS_DRIVER=log
SMSRU_API_ID=

# Push: log | expo
PUSH_DRIVER=log
EXPO_ACCESS_TOKEN=

# Антивирус для загрузок: none | clamav (docker compose --profile antivirus up)
AV_DRIVER=none

# Демо-данные в seed (только не production)
SEED_DEMO=1
GRAFANA_PASSWORD=admin
