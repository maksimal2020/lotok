{
  "name": "@lotok/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --enable-source-maps --watch-path=dist dist/main.js",
    "dev:worker": "node --enable-source-maps --watch-path=dist dist/worker.js",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/database/migrate.js",
    "db:seed": "node dist/database/seed/seed.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:int": "jest --runInBand --selectProjects integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "@lotok/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.2",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/platform-socket.io": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/websockets": "11.1.6",
    "@opensearch-project/opensearch": "2.13.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "argon2": "0.41.1",
    "bullmq": "5.34.0",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.44.5",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "multer": "2.0.2",
    "nestjs-pino": "4.4.0",
    "nodemailer": "6.9.16",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "sharp": "0.33.5",
    "socket.io": "4.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "drizzle-kit": "0.31.4",
    "jest": "29.7.0",
    "pino-pretty": "13.0.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  }
}
